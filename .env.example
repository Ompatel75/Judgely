PROJECT_NAME=Judgely
DATABASE_URL=postgresql://user:password@localhost/moj_db
SECRET_KEY=generate_a_secure_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT=15.0
AI_MAX_OUTPUT_TOKENS=1024
AI_THINKING_BUDGET=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ALWAYS_EAGER=false
AI_RESULT_TTL_SECONDS=3600
AI_SYNC_MODE=false
PROMPT_VERSION=v1
AI_CACHE_TTL_SECONDS=86400
AI_RATE_LIMIT_USER_RPM=5
AI_RATE_LIMIT_USER_RPD=50
AI_GLOBAL_RPM_LIMIT=10
AI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
